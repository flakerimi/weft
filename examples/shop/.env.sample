# The port the app listens on. weft dev gives the Go server a port of its own
# and serves the pages on 5173.
PORT=8080

# The address to listen on. Empty means every interface.
# HOST=127.0.0.1

# The database: the driver main.go imports, and where SQLite keeps the file
# (the folder is made at start).
DB_DRIVER=sqlite
DB_URL=file:data/shop.db

# The key that signs the session cookie: 32 random bytes or more, such as
# openssl rand -base64 48 gives; the app does not start while it is shorter.
# Changing it signs everyone out.
AUTH_SECRET=

# How many days a sign-in lasts, from 1 to 365.
# AUTH_SESSION_DAYS=30

# The owner, the first user. While no user exists the app logs a one-time
# link that sets the owner's password.
AUTH_OWNER_EMAIL=owner@example.com

# Who may ask for an account: invite (the default) takes only invitations an
# owner or administrator sends; open also lets anyone sign up as a viewer,
# who can read every product, so use it only when every account may; closed
# takes neither.
# AUTH_REGISTRATION=invite

# on lets other programs call the API with a key a user makes on /account;
# scripts/shop.sh turns it on.
API_KEYS=on

# The address people open the shop at, which the setup link and every mailed
# link start with. Leave it out on localhost.
# APP_URL=https://shop.example.com

# Mail: log (the default) prints each message, its links included, to the
# shop's standard error; smtp sends it through MAIL_HOST. Port 465 is TLS from the first
# byte; any other port must offer STARTTLS, unless the host is this machine.
# MAIL=log
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=Shop <noreply@shop.example.com>

# One line per request, as text (the default) or json, or off.
# LOG=text

# Requests to /api each client may make, as 300/m, 20/s or 5000/h, or off.
# RATE_LIMIT=300/m

# Behind a proxy that sets X-Forwarded-For and X-Forwarded-Proto, believe them.
# TRUST_PROXY=on
