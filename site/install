#!/bin/sh
# Weft installer: curl -fsSL https://weft.base.al/install | sh
#
# Environment:
#   WEFT_BASE     where releases live (default https://weft.base.al)
#   WEFT_VERSION  version to install (default: the latest release)
#   WEFT_BIN_DIR  where to put the binary (default $HOME/.local/bin)
set -u

base="${WEFT_BASE:-https://weft.base.al}"
bin_dir="${WEFT_BIN_DIR:-$HOME/.local/bin}"

fail() {
	printf 'weft install: %s\n' "$1" >&2
	exit 1
}

uname_s="${WEFT_TEST_UNAME_S:-$(uname -s)}"
uname_m="${WEFT_TEST_UNAME_M:-$(uname -m)}"

case "$uname_s" in
	Darwin) os=darwin ;;
	Linux) os=linux ;;
	*) os=$(printf '%s' "$uname_s" | tr '[:upper:]' '[:lower:]') ;;
esac
case "$uname_m" in
	arm64 | aarch64) arch=arm64 ;;
	x86_64 | amd64) arch=amd64 ;;
	*) arch="$uname_m" ;;
esac
case "$os/$arch" in
	darwin/arm64 | darwin/amd64 | linux/arm64 | linux/amd64) ;;
	*) fail "no build for $os/$arch" ;;
esac

command -v curl >/dev/null 2>&1 || fail "curl is needed and was not found"
if command -v sha256sum >/dev/null 2>&1; then
	sha() { sha256sum "$1" | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
	sha() { shasum -a 256 "$1" | cut -d' ' -f1; }
else
	fail "sha256sum or shasum is needed and neither was found"
fi

version="${WEFT_VERSION:-}"
if [ -z "$version" ]; then
	version=$(curl -fsSL "$base/releases/latest" 2>/dev/null | tr -d ' \r\n') ||
		fail "could not reach $base to find the latest version"
	[ -n "$version" ] || fail "could not reach $base to find the latest version"
fi

name="weft_${os}_${arch}.tar.gz"
url="$base/releases/$version"
tmp=$(mktemp -d 2>/dev/null) || fail "could not create a temporary directory"
trap 'rm -rf "$tmp"' EXIT INT TERM

curl -fsSL "$url/$name" -o "$tmp/$name" 2>/dev/null || fail "could not download $url/$name"
curl -fsSL "$url/SHA256SUMS" -o "$tmp/SHA256SUMS" 2>/dev/null || fail "could not download $url/SHA256SUMS"

want=$(awk -v n="$name" '$2 == n { print $1 }' "$tmp/SHA256SUMS")
got=$(sha "$tmp/$name")
[ -n "$want" ] && [ "$want" = "$got" ] || fail "checksum mismatch for $name"

tar -xzf "$tmp/$name" -C "$tmp" weft 2>/dev/null || fail "could not unpack $name"
mkdir -p "$bin_dir" || fail "could not create $bin_dir"
chmod 755 "$tmp/weft"
# Copy beside the target, then rename: the old binary stays until the new one is complete.
cp "$tmp/weft" "$bin_dir/.weft.new" || fail "could not write to $bin_dir"
mv -f "$bin_dir/.weft.new" "$bin_dir/weft" || fail "could not write to $bin_dir"

printf 'Installed weft %s to %s/weft\n' "$version" "$bin_dir"
case ":${PATH:-}:" in
	*":$bin_dir:"*) ;;
	*) printf 'Add %s to your PATH to run weft.\n' "$bin_dir" ;;
esac
