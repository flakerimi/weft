---
// The benchmark's landing, the same content as bench/weft/pages/index.vue.
// Each page passes its counter island in the "counter" slot.
import { Image } from 'astro:assets'
import content from '../../../content.json'
import hero from '../../../image/hero.jpg'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{content.title}</title>
    <meta name="description" content={content.description} />
    <meta property="og:title" content={content.title} />
    <meta property="og:description" content={content.description} />
  </head>
  <body>
    <main class="page">
      <header class="hero">
        <span class="tag">{content.hero.tag}</span>
        <h1 class="title">{content.hero.title}</h1>
        <p class="lead">{content.hero.lead}</p>
        <p class="sub">{content.hero.sub}</p>
      </header>

      <Image class="image" src={hero} width={content.image.width} alt={content.image.alt} />

      <section>
        <h2>Features</h2>
        <div class="grid">
          {
            content.features.map((f) => (
              <article class="card">
                <h3>{f.title}</h3>
                <p class="muted">{f.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section>
        <h2>Pricing</h2>
        <div class="grid">
          {
            content.pricing.map((p) => (
              <article class="card">
                <h3>{p.name}</h3>
                <p class="price">
                  {p.price} <span class="muted">{p.period}</span>
                </p>
                <ul class="list">
                  {p.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section>
        <h2>{content.counter.title}</h2>
        <p class="muted">{content.counter.description}</p>
        <slot name="counter" />
      </section>

      <footer class="footer muted">{content.footer}</footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafafa;
    --surface: #fff;
    --border: #e4e4e7;
    --text: #18181b;
    --muted: #71717a;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #09090b;
      --surface: #18181b;
      --border: #27272a;
      --text: #fafafa;
      --muted: #a1a1aa;
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font: 400 0.875rem/1.5 Inter, system-ui, sans-serif;
    color: var(--text);
    background: var(--bg);
  }
  h1,
  h2,
  h3,
  p,
  ul {
    margin: 0;
  }
</style>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 960px;
    margin-inline: auto;
    padding: 24px;
  }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 16px;
  }
  .tag {
    font: 0.75em/1.6 ui-monospace, monospace;
    padding: 2px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
  }
  .title {
    font-size: clamp(40px, 8vw, 72px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .lead {
    font-size: 1.35em;
    line-height: 1.35;
  }
  .muted,
  .sub {
    color: var(--muted);
  }
  .image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h2 {
    font-size: 1.25em;
    font-weight: 600;
  }
  h3 {
    font-size: 1em;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 16px;
  }
  .card {
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .price {
    font-size: 2em;
    font-weight: 700;
  }
  .price .muted {
    font-size: 0.4em;
    font-weight: normal;
  }
  .list {
    padding-left: 1.2em;
    line-height: 1.8;
  }
  .footer {
    border-top: 1px solid var(--border);
    padding-top: 24px;
    font-size: 0.85em;
  }
</style>
