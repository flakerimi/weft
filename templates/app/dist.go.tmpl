//go:build !dev

package main

import (
	"embed"
	"io/fs"
	"log"
	"net/http"
)

//go:embed all:web/dist
var webDist embed.FS

func init() {
	sub, err := fs.Sub(webDist, "web/dist")
	if err != nil {
		panic(err)
	}
	dist = sub
}

// listen serves h at port on every interface, and says where.
func listen(port string, h http.Handler) error {
	log.Printf("[[.Name]] on http://localhost:%s", port)
	return http.ListenAndServe(":"+port, h)
}
